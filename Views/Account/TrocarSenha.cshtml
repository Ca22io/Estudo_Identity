@model App.Dto.TrocarSenhaDto
@{
    ViewData["Title"] = "Trocar Senha";
}

<h1 class="text-2xl">@ViewData["Title"]</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    
    <div class="form-group mt-3">
        <label asp-for="SenhaAntiga"></label>
        <input asp-for="SenhaAntiga" class="form-control" />
        <span asp-validation-for="SenhaAntiga" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="NovaSenha"></label>
        <input asp-for="NovaSenha" class="form-control" />
        <span asp-validation-for="NovaSenha" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="ConfirmarSenha"></label>
        <input asp-for="ConfirmarSenha" class="form-control" />
        <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Trocar Senha</button>
</form>