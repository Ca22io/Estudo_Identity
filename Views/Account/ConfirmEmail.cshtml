@page
@model App.Views.Account.ConfirmEmailModel
@{
    // Define o título da página
    ViewData["Title"] = "Confirmação de E-mail";
}

<header>
    <h1 class="text-3xl font-bold mb-6 text-gray-800">@ViewData["Title"]</h1>
</header>

<div class="bg-white p-6 rounded-lg shadow-md max-w-lg mx-auto">
    <!-- Exibe a mensagem de status (sucesso ou erro) -->
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="p-4 rounded-lg 
            @(Model.StatusMessage.Contains("Obrigado") ? "bg-green-100 border-green-400 text-green-700" : "bg-red-100 border-red-400 text-red-700") 
            border-l-4" role="alert">
            <p class="font-bold">Status da Confirmação:</p>
            <p>@Model.StatusMessage</p>
        </div>
        
        <!-- Botão amigável para Login após a confirmação -->
        @if (Model.StatusMessage.Contains("Obrigado"))
        {
            <div class="mt-6 text-center">
                <a asp-page="./Login" class="inline-block px-6 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Ir para Login
                </a>
            </div>
        }
    }
    else
    {
        <!-- Mensagem de fallback caso não haja StatusMessage (não deve acontecer no fluxo normal) -->
        <p class="text-gray-600">A confirmação do seu e-mail está sendo processada...</p>
    }
</div>