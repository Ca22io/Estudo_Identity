@{
    // Define o título da página
    ViewData["Title"] = "Confirmação de E-mail";
    // Obtém a mensagem de status do TempData
    var statusMessage = TempData["StatusMessage"] as string;
    // Determina se a operação foi um sucesso para estilização condicional
    var isSuccess = !string.IsNullOrEmpty(statusMessage) && statusMessage.Contains("Obrigado");
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card bg-dark text-white shadow-lg">
                <div class="card-header">
                    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        // Define a classe do alerta com base no sucesso ou falha
                        var alertClass = isSuccess ? "alert-success" : "alert-danger";

                        <div class="@($"alert {alertClass}")" role="alert">
                            <h4 class="alert-heading">Status da Confirmação:</h4>
                            <p>@statusMessage</p>
                        </div>

                        // Se a confirmação foi bem-sucedida, exibe o botão de login
                        @if (isSuccess)
                        {
                            <hr class="border-secondary">
                            <div class="text-center mt-4">
                                <p class="mb-3">Você já pode acessar sua conta.</p>
                                <a asp-controller="Home" asp-action="Login" class="btn btn-primary btn-lg">
                                    Ir para Login
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        // Mensagem de fallback caso não haja StatusMessage
                        <p class="text-muted">A confirmação do seu e-mail está sendo processada...</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>