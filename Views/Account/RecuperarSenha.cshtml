@model App.Dto.RecuperarSenhaDto

@{
    ViewData["Title"] = "Recuperar Senha";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-white shadow-lg">
                <div class="card-header text-center">
                    <h2 class="mb-0">@ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    <p class="card-text text-center">Por favor, defina sua nova senha.</p>
                    <hr class="bg-light" />
                    <form asp-action="RecuperarSenha" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        
                        @* Campos ocultos para enviar o email e o token de volta para o servidor *@
                        <input asp-for="Email" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Nova Senha</label>
                            <input asp-for="Password" class="form-control bg-secondary text-white" type="password" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirmar Nova Senha</label>
                            <input asp-for="ConfirmPassword" class="form-control bg-secondary text-white" type="password" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Redefinir Senha</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>