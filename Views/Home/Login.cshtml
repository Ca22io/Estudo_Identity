@model App.Dto.UsuarioLoginDto
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<section class="bg-dark min-vh-100 d-flex align-items-center py-5">
    <div class="container">
        <div class="row justify-content-center">

            @if (TempData["StatusMessage"] != null)
            {
                <div class="alert alert-success text-start" role="alert">
                    @TempData["StatusMessage"]
                </div>
            }

            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card bg-dark text-white" style="border-radius: 1rem;">
                    <div class="card-body p-5 text-center">

                        <div class="mb-md-5 mt-md-4 pb-5">


                            <h2 class="fw-bold mb-2 text-uppercase">Login</h2>
                            <p class="text-white-50 mb-5">Por favor, insira seu e-mail e senha!</p>

                            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                                @Html.AntiForgeryToken()
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger text-start" role="alert"></div>

                                <div class="form-outline form-white mb-4">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control form-control-lg" placeholder="seuemail@exemplo.com" />
                                    <span asp-validation-for="Email" class="text-danger d-block text-start"></span>
                                </div>

                                <div class="form-outline form-white mb-4">
                                    <label asp-for="Password" class="form-label">Senha</label>
                                    <input asp-for="Password" class="form-control form-control-lg" placeholder="••••••••" />
                                    <span asp-validation-for="Password" class="text-danger d-block text-start"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input asp-for="RememberMe" class="form-check-input" />
                                        <label asp-for="RememberMe" class="form-check-label">Lembrar-me</label>
                                    </div>
                                    <a asp-action="RecuperarSenha" asp-controller="Home" class="text-white-50">Esqueceu a senha?</a>
                                </div>

                                <button class="btn btn-outline-light btn-lg px-5" type="submit">Entrar</button>

                            </form>
                        </div>

                        <div>
                            <p class="mb-0">Não tem uma conta? 
                                <a asp-action="Cadastrar" class="text-white-50 fw-bold">Cadastre-se</a>
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>