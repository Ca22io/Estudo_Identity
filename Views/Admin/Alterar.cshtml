@model App.Dto.UsuariosDto

@{
    ViewData["Title"] = "Alterar Usuário";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2 class="text-light mb-4">@ViewData["Title"]</h2>

    <div class="card bg-dark text-white border-secondary">
        <div class="card-body">
            <form asp-action="Alterar" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Admin" class="form-label">Perfil</label>
                    <select asp-for="Admin" class="form-select bg-dark text-white border-secondary">
                        <option value="false">Usuário Comum</option>
                        <option value="true">Administrador</option>
                    </select>
                    <span asp-validation-for="Admin" class="text-danger"></span>
                </div>
                
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Voltar para a Lista</a>
                    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>