@model List<App.Dto.UsuariosDto>

@{
    ViewData["Title"] = "Gerenciamento de Usuários";
    Layout = "_Layout";
}

<h2>@ViewData["Title"]</h2>

<div class="table-responsive">
    <table class="table table-striped table-hover table-dark">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Email</th>
                <th class="w-auto">Admin</th>
                <th class="w-auto">Ações</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr class="align-middle">
                <td>@user.Nome</td>
                <td>@user.Email</td>
                <td>
                    @if (user.Admin)
                    {
                        <span class="badge bg-success">Sim</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Não</span>
                    }
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Alterar" asp-controller="Admin" asp-route-id="@user.Id" class="btn btn-primary btn-sm">Alterar</a>
                        <form asp-action="Excluir" asp-controller="Admin" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Tem certeza que deseja excluir este usuário?');" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>